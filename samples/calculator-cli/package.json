{
  "name": "formulang-calculator-cli",
  "version": "1.0.0",
  "private": true,
  "description": "Sample of FormuLang-TS: executes formulas from the command line.",
  "type": "module",
  "bin": {
    "formulang-calculator": "./dist/main.js"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "formulang-ts": "file:../.."
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.23",
    "typescript": "~5.9"
  },
  "engines": {
    "node": ">=20"
  }
}
